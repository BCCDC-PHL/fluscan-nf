manifest {
  author = 'John Palmer'
  name = 'BCCDC-PHL/fluscan-nf'
  version = '0.1.0'
  description = 'BCCDC-PHL FluScan'
  mainScript = 'main.nf'
  nextflowVersion = '>=22.10.0'
}

params {
    cache = ''
    outdir = 'results'
    fastq_input = 'NO_FILE'
    fasta_input = 'NO_FILE'
    samplesheet_input = 'NO_FILE'
    illumina_suffixes = ['*_R{1,2}_001', '*_R{1,2}', '*_{1,2}' ]
    fastq_exts = ['.fastq.gz', '.fq.gz', '.fastq', '.fq']
    fastq_search_path = makeFastqSearchPath( illumina_suffixes, fastq_exts )
    primers = "${projectDir}/assets/primers.fa"
    run_name = parseRunName()
    aligner = 'bwa'   // 'bwa' or 'minimap2'
    target_depth = 500
    genome_size = 13500
    min_depth = 10
    lofreq_target_cov = 5000
    db = "NO_FILE"                      // reference database bundle root; see modules/shared/database.nf and docs/database_bundles.md
    merge_flumut_mutations = false      // gate the coordinate_conversion + merge_flumut_mutations steps of the NEXTCLADE workflow
    emit_no_mature_vcf = false          // additionally emit *_nc_nomat_final.vcf, annotated without mature peptides (HA as HA0 only, no HA1/HA2)
    nextclade_alignment_preset = "default"
    mnv_min_af = 0.5
    watchlist_dir = "${projectDir}/assets/watchlists"   // directory of *watchlist.csv (gene,mutation[,note]) scanned out of the final VCF in all three workflows; NO_FILE disables the scan
    consensus_coverage_pass_pct = 90    // aligned-reference coverage at/above which status is PASS
    consensus_coverage_warn_pct = 50    // aligned-reference coverage at/above which status is WARN
    consensus_identity_pass_pct = 90
    consensus_identity_warn_pct = 70
    consensus_mask_degenerate   = true   // mask degenerate IUPAC bases (R,Y,S,W,...) with N
    consensus_max_n_frac        = 0.5    // WARN if a segment's post-clean N fraction exceeds this
}

def makeFastqSearchPath ( illumina_suffixes, fastq_exts ) {
    return illumina_suffixes.collectMany { suffix -> fastq_exts.collect { ext -> "${params.fastq_input}/${suffix}${ext}".toString() } }
}

// Extract a run name from the FASTQ or FASTA input directory, or from the sample
// sheet's filename without .csv. References the input params directly so that
// command-line overrides are picked up at evaluation time.
def parseRunName () {
    def input_path = 'NO_FILE'
    if (params.fastq_input != 'NO_FILE') {
        input_path = params.fastq_input
    } else if (params.fasta_input != 'NO_FILE') {
        input_path = params.fasta_input
    } else if (params.samplesheet_input != 'NO_FILE') {
        input_path = params.samplesheet_input.toString().replaceFirst(/\.csv$/, '')
    }
    if (input_path == 'NO_FILE') {
        return 'NO_RUN_NAME'
    }
    def run_name = (input_path =~ /([^\/]+)\/?$/)[0][1]
    if (!run_name) {
        throw new RuntimeException("ERROR: Parsing run name from input path failed.")
    }
    return run_name
}

executor {
    // Cap concurrent submitted/queued tasks and submission rate to reduce HPC
    // scheduler pressure.  Tune queueSize to your cluster's per-user job limit.
    queueSize       = 200
    submitRateLimit = '10 sec'
    pollInterval    = '5 sec'
}

profiles {
    conda {
    conda.enabled = true
    process.conda = "$projectDir/environments/fluscan.yml"
    if (params.cache) {
        conda.cacheDir = params.cache
    }
    conda.useMamba = true
    }
}

process {

    withName: 'SHORT_READ:.*' {
        ext.workflow = 'short_read'
        ext.segment_regex = '(?P<sample>[^\\|]+)\\|[^\\|]+\\|[^\\|]+\\|(?P<segment>[^\\|]+)'
    }
    withName: 'FASTA_PREP:.*' {
        ext.segment_regex = '(.+)_(.+)'
    }
    withName: 'PAFTOOLS:.*' {
        ext.workflow = 'paftools'
    }
    withName: 'NEXTCLADE:.*' {
        ext.workflow = 'nextclade'
    }

    withName: short_read_assembly {
        cpus = 8
    }

    withName: short_read_map_reads_bwa {
        cpus = 8
    }

    withName: short_read_map_reads_minimap2 {
        cpus = 8
    }

    withName: short_read_sort_filter_sam {
        cpus = 8
    }

    withName: short_read_lofreq {
        cpus = 8
        memory = '16G'
    }

    withName: blastn {
        cpus = 4
    }

    withName: short_read_cutadapt {
        cpus = 8
    }

    // Batch processes: each task covers all 8 segments for one sample (paftools) or
    // all samples for one segment (nextclade).
    withName: nextclade_run_batch {
        cpus = 16
        memory = '32G'
    }

    withName: post_process_vcf {
        cpus = 16
        memory = '32G'
    }

    withName: coordinate_conversion {
        cpus = 2
        memory = '4G'
    }

    withName: merge_flumut_mutations {
        cpus = 2
        memory = '4G'
    }

    // paftools_align runs 8 minimap2 calls serially per task; minimap2 is internally
    // threaded, so 4 CPUs.
    withName: paftools_align {
        cpus = 4
        memory = '12G'
    }

    // paftools_call (paftools.js) is single-threaded; 8 calls run serially.
    withName: paftools_call {
        cpus = 2
        memory = '8G'
    }

    withName: paftools_sort_vcf {
        cpus = 2
    }

    withName: paftools_snpeff_annotation {
        cpus = 2
    }

    withName: mutation_watch {
        cpus = 1
    }
}

report {
    enabled = true
    file = "${params.outdir}/${params.run_name}_fluscan-nf_nextflow_report.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/${params.run_name}_fluscan-nf_nextflow_timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/${params.run_name}_fluscan-nf_nextflow_trace.txt"
}
