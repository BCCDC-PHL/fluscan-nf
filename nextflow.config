manifest {
  author = 'John Palmer'
  name = 'BCCDC-PHL/fluscan-nf'
  version = '0.1.0'
  description = 'BCCDC-PHL FluScan'
  mainScript = 'main.nf'
  nextflowVersion = '>=20.01.0'
}

params {
    profile = false
    cache = ''
    outdir = 'results'
    fastq_input = 'NO_FILE'
    fasta_input = 'NO_FILE'
    samplesheet_input = 'NO_FILE'
    illumina_suffixes = ['*_R{1,2}_001', '*_R{1,2}', '*_{1,2}' ]
    fastq_exts = ['.fastq.gz', '.fq.gz', '.fastq', '.fq']
    fastq_search_path = makeFastqSearchPath( illumina_suffixes, fastq_exts )
    primer_path = "${baseDir}/assets/"
    primers = "${baseDir}/assets/primers.fa"
    rev_primers = "${baseDir}/assets/primers_rev_comp.fa"
    pipeline_short_name = parsePipelineName(manifest.toMap().get('name'))
    pipeline_minor_version = parseMinorVersion(manifest.toMap().get('version'))
    run_name = parseRunName( fastq_input, fasta_input )
    aligner = 'bwa'   // 'bwa' or 'minimap2'
    target_depth = 500
    genome_size = 13500
    min_depth = 10
    min_q = 30
    min_cov = 25
    min_ident = 95
    consensus_blast_max_evalue = 1e-6
    lofreq_target_cov=5000
    nextclade_datasets_dir = "NO_FILE"
    nextclade_alignment_preset = "default"
    snpeff_config = "NO_FILE"
    nt_database = "NO_FILE"
    mnv_min_af = 0.5
    watchlist_dir = 'NO_FILE'
    segment_coverage_warn       = 0.90  // aligned ref fraction at/above which status is PASS; below it is WARN
    segment_coverage_fail       = 0.50  // below this → FAIL
    consensus_identity_pass_pct = 90
    consensus_identity_warn_pct = 70
    consensus_mask_degenerate   = true   // mask degenerate IUPAC bases (R,Y,S,W,...) with N
    consensus_max_n_frac        = 0.5    // WARN if a segment's post-clean N fraction exceeds this
    genoflu_cache = "${projectDir}/assets/genoflu"
    genoflu_github_url = 'https://github.com/USDA-VS/GenoFLU/'
    genoflu_version = "LATEST"
}

def makeFastqSearchPath ( illumina_suffixes, fastq_exts ) {
    def fastq_search_path = []
    for (suffix in illumina_suffixes){
        for (ext in fastq_exts) {
            fastq_search_path.add(params.fastq_input.toString() + '/' + suffix.toString() + ext.toString())
        }
    }
    return fastq_search_path
}

// Extract a run name from either the FASTQ or FASTA input directory path.
// References params.fastq_input and params.fasta_input directly so that
// command-line overrides are picked up at evaluation time.
def parseRunName ( fastq_input, fasta_input ) {
    def input_path = 'NO_FILE'
    if (params.fastq_input != 'NO_FILE') {
        input_path = params.fastq_input
    } else if (params.fasta_input != 'NO_FILE') {
        input_path = params.fasta_input
    }
    if (input_path == 'NO_FILE') {
        return 'NO_RUN_NAME'
    }
    def run_name = (input_path =~ /([^\/]+)\/?$/)[0][1]
    if (!run_name) {
        throw new RuntimeException("ERROR: Parsing run name from input path failed.")
    }
    return run_name
}

def parseMinorVersion(version) {
    minor_version = version.split('\\.')[0..1].join('.')
    return minor_version
}


def parsePipelineName(name) {
    short_name = name.split('/')[1]
    return short_name
}

executor {
    // Cap concurrent submitted/queued tasks and submission rate to reduce HPC
    // scheduler pressure.  Tune queueSize to your cluster's per-user job limit.
    queueSize       = 200
    submitRateLimit = '10 sec'
    pollInterval    = '5 sec'
}

profiles {
    conda {
    conda.enabled = true
    process.conda = "$baseDir/environments/fluscan.yml"
    if (params.cache) {
        conda.cacheDir = params.cache
    }
    conda.useMamba = true
    }
}

process {

    withName: 'SHORT_READ:.*' {
        ext.workflow = 'short_read'
        ext.segment_regex = '(?P<sample>[^\\|]+)\\|[^\\|]+\\|[^\\|]+\\|(?P<segment>[^\\|]+)'
    }
    withName: 'PAFTOOLS:.*' {
        ext.workflow = 'paftools'
        ext.segment_regex = '(.+)_(.+)'
    }
    withName: 'NEXTCLADE:.*' {
        ext.workflow = 'nextclade'
        ext.segment_regex = '(.+)_(.+)'
    }

    withName: short_read_assembly {
        cpus = 8
    }

    withName: short_read_map_reads_bwa {
        cpus = 8
    }

    withName: short_read_map_reads_minimap2 {
        cpus = 8
    }

    withName: short_read_sort_filter_sam {
        cpus = 8
    }

    withName: short_read_lofreq {
        cpus = 8
        memory = '16G'
    }

    withName: blastn {
        cpus = 4
    }

    withName: short_read_cutadapt {
        cpus = 8
    }

    withName: nextclade_run {
        conda = "$baseDir/environments/nextclade.yml"
        cpus = 4
    }

    withName: nextclade_to_vcf {
        conda = "$baseDir/environments/nextclade.yml"
        cpus = 2
    }

    // Batch processes: each task now covers all 8 segments for one sample
    // (paftools) or all samples for one segment (nextclade).
    withName: nextclade_run_batch {
        conda = "$baseDir/environments/nextclade.yml"
        cpus = 16
        memory = '32G'
    }

    withName: nextclade_to_vcf_batch {
        conda = "$baseDir/environments/nextclade.yml"
        cpus = 16
        memory = '32G'
    }

    withName: post_process_vcf {
        conda = "$baseDir/environments/fluscan.yml"
        cpus = 16
        memory = '32G'
    }

    withName: post_process_vcf_batch {
        conda = "$baseDir/environments/fluscan.yml"
        cpus = 16
        memory = '32G'
    }

    // paftools_align now runs 8 minimap2 calls serially per task; keep 4 CPUs
    // (minimap2 is internally threaded) and bump memory slightly for headroom.
    withName: paftools_align {
        cpus = 4
        memory = '12G'
    }

    // paftools_call (paftools.js) is single-threaded; 8 calls run serially.
    withName: paftools_call {
        cpus = 2
        memory = '8G'
    }

    withName: paftools_sort_vcf {
        cpus = 2
    }

    withName: paftools_snpeff_annotation {
        cpus = 2
    }

    withName: short_read_summarize_vcf {
        cpus = 2
    }
}

report {
    enabled = true
    file = "${params.outdir}/${params.run_name}_fluscan-nf_nextflow_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/${params.run_name}_fluscan-nf_nextflow_timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/${params.run_name}_fluscan-nf_nextflow_trace.txt"
}
